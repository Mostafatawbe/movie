<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComputerShop"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ComputerShop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.ComputerShop" />
            
        <activity
            android:name=".activities.SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.ComputerShop" />
            
        <activity
            android:name=".activities.ProductDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.ComputerShop" />
            
        <activity
            android:name=".activities.CheckoutActivity"
            android:exported="false"
            android:theme="@style/Theme.ComputerShop" />
            
        <activity
            android:name=".activities.OrderDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.ComputerShop" />
            
        <activity
            android:name=".activities.AdminPanelActivity"
            android:exported="false"
            android:theme="@style/Theme.ComputerShop" />
            
        <activity
            android:name=".activities.AddEditProductActivity"
            android:exported="false"
            android:theme="@style/Theme.ComputerShop" />

    </application>

</manifest>
